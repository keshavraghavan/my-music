# MyMusic environment configuration
#
# Copy to `.env.local` and fill in what you need:
#
#   cp .env.example .env.local
#
# Nothing here is required just to see the app: `npm install && npm run dev`
# uses a bundled read-only snapshot. Set DATABASE_URL to use the persistent
# Phase 3 read model; the remaining variables are optional until their phases.
# A fork should never need an API key just to see the thing run.
#
# The variables are listed in the order the roadmap introduces them
# (docs/ROADMAP.md — Part 4). Each is marked with the phase that starts
# reading it; until then it is documentation, not configuration.

# ── Phase 3: database ────────────────────────────────────────────────────────
# Postgres connection string. `docker compose up -d` provides this local
# instance. Leave it unset to render the bundled read-only fixture snapshot.
DATABASE_URL="postgresql://mymusic:mymusic@localhost:5432/mymusic"

# ── Phase 4: authentication ──────────────────────────────────────────────────
# Secret used to sign session cookies. Generate one with:
#   openssl rand -base64 32
# AUTH_SECRET=""

# Canonical origin of the app; used to build OAuth callback URLs.
# AUTH_URL="http://localhost:3000"

# Transactional email (magic links, digests). Without it, dev logs the link to
# the console instead of sending mail.
# RESEND_API_KEY=""
# EMAIL_FROM="MyMusic <hello@example.test>"

# Where new moderation reports are emailed. Falls back to logging.
# MODERATION_ALERT_EMAIL=""

# ── Phase 6: music services ──────────────────────────────────────────────────
# With neither block set, the app uses the mock MusicProvider: real listening
# data is simulated, every screen populates, and no account is needed.
#
# Spotify — create an app at https://developer.spotify.com/dashboard and add
# <AUTH_URL>/api/music/callback/spotify as a redirect URI for listening access.
# If Spotify is also used for sign-in, keep
# <AUTH_URL>/api/auth/callback/spotify registered as a second redirect URI.
# SPOTIFY_CLIENT_ID=""
# SPOTIFY_CLIENT_SECRET=""

# Apple Music — requires a paid Apple Developer account to sign a MusicKit
# token, so it is deliberately optional. Left unset, Apple Music shows as
# unavailable rather than broken.
# APPLE_MUSIC_TEAM_ID=""
# APPLE_MUSIC_KEY_ID=""
# APPLE_MUSIC_PRIVATE_KEY=""

# Encrypts OAuth and music-service access/refresh tokens at rest. Required when
# Spotify sign-in or any real music provider is configured. Generate with:
#   openssl rand -hex 32
# TOKEN_ENCRYPTION_KEY=""
